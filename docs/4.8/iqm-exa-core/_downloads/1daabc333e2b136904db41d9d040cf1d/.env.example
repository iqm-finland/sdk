# ================================================================================
# LOGGER CONFIGURATION FILE PATH
# Sensible default logger configuration is used in case this is not set. 
# See loggers.yml.example for example configuration. 
#
# ALLOWED: Absolute path as string
# DEFAULT: ""
# ================================================================================
EXA_LOGGERS_CONF_PATH=""

# ================================================================================
# CONFIGURATION FILE PATH
# Path to the configuration (.yml) file that is read when using experiments.
#
# ALLOWED: Absolute path as string
# DEFAULT: ""
# ================================================================================
EXA_CONFIGURATION_PATH=""

# ================================================================================
# STATION CONTROL SERVICE URL
# Root URL to the remote station control service.
#
# ALLOWED: Root URL as string
# DEFAULT: ""
# ================================================================================
STATION_CONTROL_SERVICE_URL=""

# ================================================================================
# QCM DATA API URL
# ALLOWED: File directory URL like "file:///opt/config" or HTTP URL where QCM data
# can be retrieved using HTTP GET. Query "?chip_label=<chip_label>" will be added
# to the HTTP URL by the server.
# NOTE: This is not used at all when using remote station control,
# but required when using monolithic station control.
# DEFAULT: ""
# ================================================================================
QCM_DATA_API_URL=""

# ================================================================================
# CHIP DESIGN_RECORD FALLBACK URL
# Optional HTTP URL to use in case the requested chip design records are not
# available from the remote station control instance, for example if it is using
# a CHEDDAR file, where QCM data can be retrieved using HTTP GET.
# Query "?chip_label=<chip_label>" will be added to the HTTP URL by the server.
# NOTE: This is only used in case the remote station-control is unable to provide
# the requested chip design records, and is not necessary for execution.
# This has no impact in monolith mode.
# DEFAULT: ""
# ================================================================================
CHIP_DESIGN_RECORD_FALLBACK_URL=""

# ================================================================================
# RELATIONAL DATABASE CONNECTION URL
# Database where data is stored.
#
# ALLOWED:
# - "sqlite:///:memory:" (Temporary in-memory database)
# - "sqlite:///my_local_database.db" (Local file, path and name can be chosen freely)
# - For a central database, the database URL is given in private communication
# NOTE: This URL may contain a password and should not be stored in git.
# NOTE: This is not used at all when using remote station control,
# but required when using monolithic station control.
# DEFAULT: none
# ================================================================================
EXA_RDBMS_URL="sqlite:///exa-data-test.db"
